import numpy as np
import matplotlib.pyplot as plt

class ContinuousGridworld1D_vStoc(object):
    def __init__(self, sigma, gamma):
        self.sigma = sigma
        self.gamma = gamma

    def reset(self):
        self.agent_pos = 0.0  # scalar, not array
        return np.array([self.agent_pos], dtype=float)

    def step(self, action):
        z = np.random.normal(0, 1)
        cost = 0.5*(self.agent_pos**2 + action**2)
        self.agent_pos = self.agent_pos + action + self.sigma * z
        return np.array([self.agent_pos], dtype=float), float(cost)

# Simulation parameters
sigma = 0.1
gamma = 0.99
T = 10
M = 10**5

env = ContinuousGridworld1D_vStoc(sigma, gamma)
cumulative_costs = np.zeros(M)

for m in range(M):
    state = env.reset()
    total_cost = 0.0
    for t in range(T):
        #action = np.random.uniform(-1, 1)
        action = - 0.5*state + 0.2*np.random.normal(1)
        next_state, cost = env.step(action)
        total_cost += cost
    cumulative_costs[m] = total_cost

# Plotting the histogram
plt.hist(cumulative_costs, bins=100, density=True, alpha=0.75)
plt.title(f"Distribution of Cumulative Cost over {M} Episodes")
plt.xlabel("Cumulative Cost")
plt.ylabel("Density")
plt.grid(True)
plt.show()

# 1) Build a frequency grid
W       = 10.0       # max frequency
N_omega = 200       # number of ω points
omega_grid = np.linspace(-W, W, N_omega)

# 2) Compute empirical CF: φ̂(ω) = E[e^{i ω J}]
phi_hat = np.mean(np.exp(1j * omega_grid[:, None] * cumulative_costs[None, :]), axis=1)
fig, (ax1, ax2) = plt.subplots(2,1,figsize=(8,8), sharex=True)

ax1.plot(omega_grid, phi_hat.real, color='C0')
ax1.set_ylabel(r"$\Re\,\hat\phi$")
ax1.set_title("Real Part")
ax1.grid(True)

ax2.plot(omega_grid, phi_hat.imag, color='C1')
ax2.set_xlabel(r"$\omega$")
ax2.set_ylabel(r"$\Im\,\hat\phi$")
ax2.set_title("Imaginary Part")
ax2.grid(True)

plt.tight_layout()
plt.show()

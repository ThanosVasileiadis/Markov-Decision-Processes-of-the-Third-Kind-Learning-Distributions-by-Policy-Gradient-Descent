# ─────────── General settings  ───────────
T = 1  # one period
R = 1.0  # amplitude in r = R cos(s0 + a + xi)
s0 = 0.0  # phase offset
sigma = 0.20  # noise std for xi
M = 72 * 1024  # trajectories per epoch
W = 100.0  # frequency cutoff
N_omega = 8001  # grid size for CF (odd is nice)
alpha = 0.015  # kernel bandwidth for CF loss weights
epochs = 2000
lr = 1e-3
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
Kmax = 16

# ===================== Save figure helper =====================
SAVE_FIGS = True

from scipy.special import jv


# --- 1) Numerical solver for ψ_A(k) via Eq. (10) (least squares) ---
def solve_eq10_psiA(R, s0, sigma, W, N_omega, Kmax, enforce_real=False):
    omega = np.linspace(-W, W, N_omega)

    # φ_E(ω) as before (real target)
    def phi_epan(omega, R):
        out = np.empty_like(omega, dtype=float)
        small = np.isclose(omega, 0.0)
        out[small] = 1.0
        w = omega[~small]
        out[~small] = (3.0 / (R ** 3 * w ** 3)) * (np.sin(w * R) - (w * R) * np.cos(w * R))
        return out

    phiE = phi_epan(omega, R)  # (L,)
    J0 = jv(0, omega * R)  # (L,)
    bprime = phiE - J0

    # A[ℓ,k] = 2 J_k(ωℓ R) e^{-0.5 k^2 σ^2}, k=1..Kmax
    L = N_omega
    A = np.zeros((L, Kmax), dtype=float)
    atten = np.exp(-0.5 * (np.arange(1, Kmax + 1) ** 2) * (sigma ** 2))
    for k in range(1, Kmax + 1):
        A[:, k - 1] = 2.0 * jv(k, omega * R) * atten[k - 1]

    # least squares for x_k
    x, *_ = np.linalg.lstsq(A, bprime, rcond=None)

    # ψ_A(k) = i^{-k} e^{-ik s0} x_k  (k ≥ 1), ψ_A(0)=1
    def i_pow_minus_k(k):
        r = k % 4
        return (1.0 + 0.0j) if r == 0 else (-1j if r == 1 else (-1.0 + 0.0j if r == 2 else 1j))

    psiA = np.zeros(Kmax + 1, dtype=np.complex128)
    psiA[0] = 1.0 + 0.0j
    for k in range(1, Kmax + 1):
        psi = i_pow_minus_k(k) * np.exp(-1j * k * s0) * x[k - 1]
        if enforce_real:  # enforce symmetry of a on the circle
            psi = np.real(psi) + 0j
        # project |ψ_A(k)| ≤ 1 for numerical safety
        m = np.abs(psi)
        if m > 1.0:
            psi /= m
        psiA[k] = psi
    return omega, psiA


omega_solve, psiA_solver = solve_eq10_psiA(R, s0, sigma, W, N_omega, Kmax, enforce_real=False)


# --- 2) Circular density p(θ) from ψ_A and sampling helper ---
def circular_density_from_psiA(psiA, theta_grid):
    # p(θ) = 1/(2π) [1 + 2 Σ_{k=1..K} Re( ψ_A(k) e^{-ikθ} )]
    Kmax = len(psiA) - 1
    ks = np.arange(1, Kmax + 1)[:, None]  # (K,1)
    exp_term = np.exp(-1j * ks * theta_grid[None, :])  # (K, Nθ)
    p = (1.0 / (2 * np.pi)) * (1.0 + 2.0 * np.real((psiA[1:, None] * exp_term).sum(axis=0)))
    p = np.maximum(p, 0.0)  # avoid tiny negatives
    # renormalize on the circle
    Z = np.trapz(p, theta_grid)
    if Z > 0:
        p /= Z
    else:
        p[:] = 1.0 / (theta_grid[-1] - theta_grid[0])
    return p


def sample_from_circular_density(theta_grid, p, n, rng):
    # trapezoidal CDF over [-π, π], inverse-CDF sampling
    cdf = np.cumsum(0.5 * (p[1:] + p[:-1]) * np.diff(theta_grid))
    cdf = np.hstack([[0.0], cdf]);
    cdf /= cdf[-1]
    u = rng.random(n)
    return np.interp(u, cdf, theta_grid)


# Build p_solver(θ) and sample actions from the solver
Nθ = 4096
Kmax = 16
theta_grid = np.linspace(0, np.pi, Nθ)
p_theta = circular_density_from_psiA(psiA_solver, theta_grid)
rng = np.random.default_rng(0)
n_cmp = 50000
a_solver = sample_from_circular_density(theta_grid, p_theta, n_cmp, rng)


# --- 3) Sample actions from the trained policy (x=0, J=0, τ=1) and wrap to [-π, π] ---
@torch.no_grad()
def sample_policy_actions(policy, n_samples=50000):
    x = torch.zeros(n_samples, 1, device=device)
    J = torch.zeros(n_samples, 1, device=device)
    z = torch.randn(n_samples, 1, device=device)
    tau = torch.ones(n_samples, 1, device=device)

    a = policy(x, J, z, tau)  # (n,1), real-valued output

    # ---- conditional projection: only if a ∈ [-2π, 0] ----
    mask = (a >= -2 * torch.pi) & (a <= 0)
    a = torch.where(mask, a % (2 * torch.pi), a)

    return a.squeeze().cpu().numpy()


a_policy = sample_policy_actions(policy, n_samples=n_cmp)


# --- 4) Moment comparison on the circle: ψ̂_A(k) = E[e^{ik a}] for k=1..K_show ---
def circular_moments(a, K_show=8):
    moms = []
    for k in range(1, K_show + 1):
        moms.append(np.mean(np.exp(1j * k * a)))
    return np.array(moms, dtype=np.complex128)


K_show = min(16, Kmax)
psi_policy_emp = circular_moments(a_policy, K_show=K_show)
psi_solver_the = psiA_solver[1:K_show + 1]

# Print a quick table of the first few circular moments
print("\nFirst circular moments ψ_A(k) = E[e^{ik a}]")
print("k |   policy (empirical)                |   solver (theory)                  |  |Δ|")
for k in range(1, K_show + 1):
    pval = psi_policy_emp[k - 1]
    tval = psi_solver_the[k - 1]
    diff = np.abs(pval - tval)
    print(f"{k:1d} | {pval.real:+.4f}{pval.imag:+.4f}i   | {tval.real:+.4f}{tval.imag:+.4f}i   | {diff:.4e}")

# --- 5) Simple CF-style distance over integer harmonics 1..K_show ---
cf_dist = np.sqrt(np.mean(np.abs(psi_policy_emp - psi_solver_the) ** 2))
print(f"\nCF-harmonic RMSE over k=1..{K_show}: {cf_dist:.4e}")


def savefig(name, dpi=300):
    path = os.path.join(FIG_DIR, f"{name}.png")
    plt.savefig(path, dpi=dpi, bbox_inches='tight')
    print(f"[saved] {path}")


# ─────────── Build frequency grid & kernel weights ───────────
omega_np = np.linspace(-W, W, N_omega)  # (N_omega,)
omega_grid = torch.tensor(omega_np, device=device, dtype=torch.float32).reshape(-1, 1)  # (N_omega,1)
K_w = torch.exp(-alpha * omega_grid.flatten() ** 2)  # (N_omega,)
Δω = float(2 * W / (N_omega - 1))


# ─────────── Epanechnikov target CF φ_E(ω) (real) ───────────
def phi_epanechnikov_np(omega, R):
    out = np.empty_like(omega, dtype=float)
    small = np.isclose(omega, 0.0)
    out[small] = 1.0
    w = omega[~small]
    out[~small] = (3.0 / (R ** 3 * w ** 3)) * (np.sin(w * R) - (w * R) * np.cos(w * R))
    return out


phiE_real_np = phi_epanechnikov_np(omega_np, R)  # real
phi_target_vals = torch.tensor(phiE_real_np, device=device, dtype=torch.complex64)  # imag=0 target


class ImplicitPolicy(nn.Module):
    def __init__(self, hidden_dim: int = 256, n_blocks: int = 2):
        super().__init__()
        # input: x (1) + J (1) + z (1) + tau (1) = 4
        self.input_layer = nn.Linear(4, hidden_dim)
        self.input_ln = nn.LayerNorm(hidden_dim)
        self.blocks = nn.ModuleList([
            nn.ModuleDict({
                'fc': nn.Linear(hidden_dim, hidden_dim),
                'ln': nn.LayerNorm(hidden_dim),
            }) for _ in range(n_blocks)
        ])
        self.output_layer = nn.Linear(hidden_dim, 1)

        # --- Important in Option 1: avoid tanh saturation at init ---
        nn.init.zeros_(self.output_layer.weight)
        nn.init.zeros_(self.output_layer.bias)

        # learnable temperature (keeps tanh in its linear region early on)
        self.squash_scale = nn.Parameter(torch.tensor(0.5))  # start < 1

    def forward(self, x, J, z, tau):
        h = torch.cat([x, J, z, tau], dim=-1)
        h = F.relu(self.input_ln(self.input_layer(h)))
        for block in self.blocks:
            r = h
            h = F.relu(block['ln'](block['fc'](h)))
            h = h + r

        raw = self.output_layer(h)  # R-valued

        return raw


policy = ImplicitPolicy().to(device)
optimizer = optim.Adam(policy.parameters(), lr=lr)


# ─────────── One-period dynamics / "reward" transition ───────────
# J will accumulate a single cost equal to r = R cos(s0 + a + xi)
def step_one_period(x, a):
    eps = torch.randn_like(a)  # xi
    r = R * torch.cos(s0 + a + sigma * eps)  # scalar reward/cost
    x_next = x  # no state evolution needed
    cost = r
    return x_next, cost


# ─────────── Training loop (CF matching to Epanechnikov) ───────────
for epoch in range(epochs):
    x = torch.zeros(M, 1, device=device)
    J = torch.zeros(M, 1, device=device)

    for t in range(T):  # T=1, but keep the structure
        z = torch.randn(M, 1, device=device)
        x_in = x  # no normalization needed, but keep same inputs
        J_in = J
        tau = torch.full((M, 1), float((T - t) / T), device=device)  # =1.0 at t=0

        a = policy(x_in, J_in, z, tau)

        x, c = step_one_period(x, a)
        J += c

    # empirical CF of learned one-period return r (=J)
    Jt = J.t()  # (1,M)
    exp_t = torch.exp(1j * (omega_grid @ Jt))  # (N_omega, M)
    phi_hat = exp_t.mean(dim=1)  # (N_omega,)
    # ---------- CF loss on rewards ----------
    rd = (phi_hat.real - phi_target_vals.real)
    id = phi_hat.imag
    loss = Δω * torch.sum(K_w * (rd ** 2 + 5 * id ** 2))

    optimizer.zero_grad()
    loss.backward()
    optimizer.step()

    if epoch % 50 == 0:
        print('J median/99p:', J.detach().abs().median().item(),
              J.detach().abs().quantile(0.99).item())
        print('J mean/median:', J.mean().item(), J.median().item())
        print(f"Epoch {epoch:3d} | loss = {loss.item():.6f}")

    if loss.item() < 1e-4:
        print(f"Early stopping at epoch {epoch:3d} | loss = {loss.item():.6e}")
        break


# ─────────── Post-training evaluation ───────────
@torch.no_grad()
def estimate_phi(policy, n_traj=8192):
    x = torch.zeros(n_traj, 1, device=device)
    J = torch.zeros(n_traj, 1, device=device)
    for t in range(T):  # T=1
        z = torch.randn(n_traj, 1, device=device)
        tau = torch.full((n_traj, 1), float((T - t) / T), device=device)
        a = policy(x, J, z, tau)
        x, c = step_one_period(x, a)
        J += c
    exp_t = torch.exp(1j * (omega_grid @ J.t()))
    return exp_t.mean(dim=1).cpu().numpy(), J.squeeze().cpu().numpy()


phi_learned, learned_returns = estimate_phi(policy)


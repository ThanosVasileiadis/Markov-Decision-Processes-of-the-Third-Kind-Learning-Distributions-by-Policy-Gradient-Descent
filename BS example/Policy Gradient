# ─────────── Implicit stochastic policy ───────────
class ImplicitPolicy(nn.Module):
    def __init__(self, hidden_dim: int = 256, n_blocks: int = 3):
        super().__init__()
        # input: s (1)  + z (1) + tau (1) = 4 features
        self.input_layer = nn.Linear(3, hidden_dim)
        self.input_ln = nn.LayerNorm(hidden_dim)
        self.blocks = nn.ModuleList([
            nn.ModuleDict({
                'fc': nn.Linear(hidden_dim, hidden_dim),
                'ln': nn.LayerNorm(hidden_dim),
            }) for _ in range(n_blocks)
        ])
        self.output_layer = nn.Linear(hidden_dim, 1)

    def forward(self, s, z, tau):
        h = torch.cat([s, z, tau], dim=-1)
        h = F.relu(self.input_ln(self.input_layer(h)))
        for block in self.blocks:
            r = h
            h = F.relu(block['ln'](block['fc'](h)))
            h = h + r
        logits = self.output_layer(h)  # unconstrained
        # pi_max = 1.0  # allow up to 100% long/short; tweak as desired
        # pi = pi_max * torch.tanh(logits)  # fraction in [-pi_max, pi_max]
        # pi = torch.clamp(logits, -1, 1)
        # pi = 0.5 * (torch.tanh(logits) + 1.0)
        pi = torch.sigmoid(logits)  # (0,1)
        return pi
        # return self.output_layer(h)


policy = ImplicitPolicy().to(device)
optimizer = optim.Adam(policy.parameters(), lr=lr)


# ─────────── Vectorized environment step: terminal-wealth dynamics ───────────
# s_{n+1} = e^{r Δt} ( s_n + a_n * y_{n+1} )
# y_{n+1} = exp((μ - ½σ² - r)Δt + σ√Δt ε) - 1,  ε ~ N(0,1)
def step_wealth(s, a):
    eps = torch.randn_like(s)

    # Risk-free multiplier
    Rf = torch.exp(torch.tensor(r_bs * dt, device=s.device))

    # Stock gross return G_{n+1}
    G = torch.exp(
        (mu_bs - 0.5 * sigma_bs ** 2) * dt
        + sigma_bs * torch.sqrt(torch.tensor(dt, device=s.device)) * eps
    )

    # Excess return over the risk-free asset
    Y = G / Rf - 1.0

    # Wealth evolution
    s_next = Rf * s * (1.0 + a * Y)

    return s_next


# ─────────── Training loop (CF‐matching on terminal wealth) ───────────
Δω = 2 * W / (N_omega - 1)  # for quadrature
for epoch in range(epochs):
    # s holds wealth; J will mirror "current" wealth so that at the end J = s_T
    s = torch.full((M, 1), s0, device=device)
    J = s.clone()

    for t in range(T):
        z = torch.randn(M, 1, device=device)
        s_in = s
        J_in = J
        tau = torch.full((M, 1), float((T - t) / T), device=device)
        a = policy(s_in, z, tau)  # action (free-form; network learns)
        s_next = step_wealth(s, a)
        J = s_next
        # keep J in sync with wealth so that after the loop J=s_T
        # c = s_next - J
        s = s_next
        # J = J + c

    # empirical CF of terminal wealth (stored in J)
    Jt = J.t()  # (1,M)
    exp_t = torch.exp(1j * (omega_grid @ Jt))  # (N_omega, M)
    phi_hat = exp_t.mean(dim=1)  # (N_omega,)

    # weighted L2 loss to your empirical target CF
    rd = phi_hat.real - phi_target_vals.real
    id = phi_hat.imag - phi_target_vals.imag
    loss = Δω * torch.sum(K * (rd ** 2 + id ** 2))

    optimizer.zero_grad()
    loss.backward()
    optimizer.step()

    if epoch % 50 == 0:
        print('Wealth | median/99p:', J.detach().abs().median().item(),
              J.detach().abs().quantile(0.99).item())

    if epoch % 50 == 0 or epoch == epochs - 1:
        print(f"Epoch {epoch:3d} | loss = {loss.item():.5f}")

    if loss.item() < 1e-3:
        print(f"Early stopping at epoch {epoch:3d} with loss = {loss.item():.5f}")
        break


# ─────────── Post‐training evaluation ───────────
@torch.no_grad()
def estimate_phi(policy, n_traj=4096):
    s = torch.full((n_traj, 1), s0, device=device)
    J = s.clone()
    for t in range(T):
        z = torch.randn(n_traj, 1, device=device)
        tau = torch.full((n_traj, 1), float((T - t) / T), device=device)
        a = policy(s, z, tau)
        s_next = step_wealth(s, a)
        # c = s_next - J
        # s = s_next
        # J = J + c
        J = s_next
    exp_t = torch.exp(1j * (omega_grid @ J.t()))
    return exp_t.mean(dim=1).cpu().numpy()


phi_learned = estimate_phi(policy)


def plot_action_distributions(policy, x_values, n_samples=10000, bins=50, J0=s0):
    """
    Draws overlaid histograms of actions sampled from `policy` at each wealth state in `x_values`.
    """
    plt.figure(figsize=(8, 5))
    for x0 in x_values:
        s = torch.full((n_samples, 1), float(x0), device=device)
        J = torch.full((n_samples, 1), float(J0), device=device)
        z = torch.randn(n_samples, 1, device=device)
        tau = torch.ones(n_samples, 1, device=device)  # start-of-episode
        with torch.no_grad():
            a = policy(s, z, tau)
        actions = a.cpu().numpy().flatten()
        print(f"State s = {x0}: action mean = {actions.mean():.4f}, std = {actions.std(ddof=1):.4f}")
        sns.histplot(actions, bins=bins, stat="density", label=f"s = {x0}",
                     element="step", fill=False)

    plt.title("Action Distributions for Different Wealth States")
    plt.xlabel("Action value");
    plt.ylabel("Density")
    plt.legend(title="State");
    plt.grid(True);
    plt.tight_layout()

    plt.savefig("figures/action_distributions.png", dpi=300)
    print("Saved action distributions to figures/action_distributions.png")

    plt.show();
    plt.close()



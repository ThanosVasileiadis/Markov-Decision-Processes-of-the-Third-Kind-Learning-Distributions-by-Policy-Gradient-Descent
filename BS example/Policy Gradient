# Black–Scholes model parameters
s0 = 100.0  # initial wealth
r_bs = 0.02  # risk-free rate (annualized)
mu_bs = 0.06  # stock drift (annualized)
sigma_bs = 0.40  # stock volatility (annualized)
T_years = 1.0  # horizon in years
dt = T_years / T
growth = np.exp(r_bs * dt)  # e^{r Δt}
diff_term = sigma_bs * np.sqrt(dt)  # σ √Δt
drift_adj = (mu_bs - 0.5 * sigma_bs ** 2 - r_bs) * dt  # (μ - ½σ² - r)Δt


def profile_config(name: str) -> Config:
    cfg = Config(profile=name)
    if name == "article":
        # Match the public BS script; the manuscript's generic architecture differs.
        return replace(cfg, policy_inputs=3, blocks=3, zero_output=False,
                       train_batch=102400, epochs=201, quadrature="rectangle",
                       early_stop=1e-3, figure_policy="last")
    if name == "resolved":
        # Explicit alternative objective resolving the narrow low-frequency peak.
        return replace(cfg, frequency_cutoff=0.5, frequencies=1001, state_scale=100.0)
    if name != "prototype":
        raise ValueError("profile must be article, prototype, or resolved")
    return cfg


def write_json(path: Path, value) -> None:
    # JSON output is portable: missing/nonfinite diagnostics are represented by null.
    def clean(x):
        if isinstance(x, dict):
            return {str(k): clean(v) for k, v in x.items()}
        if isinstance(x, (list, tuple)):
            return [clean(v) for v in x]
        if isinstance(x, (np.floating, np.integer)):
            return clean(x.item())
        if isinstance(x, float) and not math.isfinite(x):
            return None
        return x
    path.write_text(json.dumps(clean(value), indent=2, allow_nan=False) + "\n")


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load_checkpoint(path) -> dict:
    # Checkpoints contain optimizer and RNG metadata. Load your own trusted files.
    try:
        return torch.load(path, map_location="cpu", weights_only=False)
    except TypeError:
        return torch.load(path, map_location="cpu")


def validate(cfg: Config) -> None:
    positive = ("horizon", "target_n", "width", "epochs", "train_batch", "train_chunk",
                "eval_every", "eval_chunk", "validation_batch", "validation_replicates",
                "test_batch", "test_replicates", "checkpoint_every", "figure_samples",
                "figure_cf_samples", "figure_action_samples", "figure_dpi", "audit_batch",
                "audit_replicates", "perturbation_batch", "perturbation_replicates")
    if any(getattr(cfg, k) < 1 for k in positive):
        raise ValueError("Sample counts, intervals, width, horizon and epochs must be positive")
    if cfg.scenario not in {"full_stock", "uniform", "both"}:
        raise ValueError("scenario must be full_stock, uniform, or both")
    if cfg.target_file and cfg.scenario == "both" and "{scenario}" not in cfg.target_file:
        raise ValueError("For both scenarios, target_file must contain {scenario}")
    if cfg.frequencies < 3 or cfg.frequencies % 2 != 1:
        raise ValueError("frequencies must be odd and at least 3")
    if cfg.blocks < 0 or cfg.policy_inputs not in (3, 4):
        raise ValueError("blocks must be nonnegative; policy_inputs must be 3 or 4")
    if not math.isfinite(cfg.output_init_std) or cfg.output_init_std < 0:
        raise ValueError("output_init_std must be finite and nonnegative")
    if cfg.zero_output and cfg.output_init_std > 0:
        raise ValueError("Use --no-zero-output with a positive --output-init-std")
    if cfg.quadrature not in {"trapezoid", "rectangle"}:
        raise ValueError("quadrature must be trapezoid or rectangle")
    if min(cfg.years, cfg.s0, cfg.frequency_cutoff, cfg.learning_rate, cfg.state_scale,
           cfg.decay_timescale) <= 0 or cfg.sigma < 0 or cfg.weight_alpha < 0:
        raise ValueError("Invalid model, grid, scaling or learning-rate parameter")
    if cfg.optimizer not in {"adam", "sgd"}:
        raise ValueError("optimizer must be adam or sgd")
    if cfg.optimizer == "sgd" and not 0.5 < cfg.decay_exponent <= 1:
        raise ValueError("SGD decay_exponent must be in (0.5, 1]")
    if cfg.early_stop < 0 or cfg.gradient_tolerance < 0 or cfg.perturbation_directions < 0:
        raise ValueError("Thresholds and perturbation direction count must be nonnegative")
    if cfg.action_samples < 0 or min(cfg.action_every, cfg.action_lag) < 1:
        raise ValueError("action_samples must be nonnegative; action intervals positive")
    if cfg.figure_policy not in {"best", "last"}:
        raise ValueError("figure_policy must be best or last")
    probe_spec(cfg)
    if any(x <= 0 for x in comma_numbers(cfg.perturbation_scales)):
        raise ValueError("Perturbation scales must be positive")
    if any(getattr(cfg, k) < 0 for k in ("seed", "target_seed", "action_seed", "cpu_threads")):
        raise ValueError("Seeds and CPU thread count must be nonnegative")
    for key, value in asdict(cfg).items():
        if isinstance(value, float) and not math.isfinite(value):
            raise ValueError(f"Nonfinite config field: {key}")


def configure_runtime(cfg: Config) -> torch.device:
    allocated = int(os.environ.get("SLURM_CPUS_PER_TASK", os.cpu_count() or 1))
    threads = cfg.cpu_threads or min(4, allocated)
    if threads > allocated:
        raise ValueError("cpu_threads exceeds allocated CPUs")
    torch.set_num_threads(threads)
    device = torch.device(cfg.device)
    if device.type not in {"cpu", "cuda"}:
        raise ValueError("Use cpu, cuda, or cuda:N")
    if device.type == "cuda":
        if not torch.cuda.is_available():
            raise RuntimeError("CUDA unavailable; request a GPU allocation or use --device cpu")
        torch.cuda.set_device(device.index or 0)
        device = torch.device("cuda", torch.cuda.current_device())
    torch.use_deterministic_algorithms(cfg.deterministic)
    if cfg.deterministic:
        os.environ.setdefault("CUBLAS_WORKSPACE_CONFIG", ":4096:8")
        torch.backends.cudnn.benchmark = False
    print(f"PyTorch={torch.__version__} device={device} CPU_threads={threads}", flush=True)
    return device


class Policy(nn.Module):
    """Implicit distribution over the investment FRACTION pi in (0, 1)."""
    def __init__(self, cfg: Config):
        super().__init__()
        self.policy_inputs, self.state_scale = cfg.policy_inputs, cfg.state_scale
        self.input = nn.Linear(cfg.policy_inputs, cfg.width)
        self.input_norm = nn.LayerNorm(cfg.width)
        self.blocks = nn.ModuleList(nn.ModuleDict({
            "linear": nn.Linear(cfg.width, cfg.width), "norm": nn.LayerNorm(cfg.width)
        }) for _ in range(cfg.blocks))
        self.output = nn.Linear(cfg.width, 1)
        if cfg.zero_output:
            nn.init.zeros_(self.output.weight)
            nn.init.zeros_(self.output.bias)
        elif cfg.output_init_std > 0:
            # Start near a half-investment policy with input-dependent logits.
            nn.init.normal_(self.output.weight, mean=0.0, std=cfg.output_init_std)
            nn.init.zeros_(self.output.bias)

    def forward(self, wealth, reward, noise, time_to_go):
        values = (wealth / self.state_scale, noise, time_to_go)
        if self.policy_inputs == 4:
            values = (wealth / self.state_scale, reward / self.state_scale, noise, time_to_go)
        h = F.relu(self.input_norm(self.input(torch.cat(values, dim=1))))
        for block in self.blocks:
            h = h + F.relu(block["norm"](block["linear"](h)))
        return torch.sigmoid(self.output(h))


def wealth_step(wealth, fraction, market_noise, cfg: Config):
    dt = cfg.years / cfg.horizon
    bond = math.exp(cfg.risk_free * dt)
    excess = torch.expm1((cfg.drift - 0.5 * cfg.sigma ** 2 - cfg.risk_free) * dt
                         + cfg.sigma * math.sqrt(dt) * market_noise)
    return bond * wealth * (1 + fraction * excess)


def rollout(policy: Policy, n: int, cfg: Config, generator=None) -> torch.Tensor:
    parameter = next(policy.parameters())
    opts = {"device": parameter.device, "dtype": parameter.dtype}
    wealth = torch.full((n, 1), cfg.s0, **opts)
    reward = torch.zeros_like(wealth)  # No rewards are paid before terminal time.
    for t in range(cfg.horizon):
        z = torch.randn(n, 1, generator=generator, **opts)
        tau = torch.full((n, 1), (cfg.horizon - t) / cfg.horizon, **opts)
        fraction = policy(wealth, reward, z, tau)
        eps = torch.randn(n, 1, generator=generator, **opts)
        wealth = wealth_step(wealth, fraction, eps, cfg)
    return wealth[:, 0]  # The return is terminal wealth, not a sum of wealth levels.


def simulate_target(cfg: Config) -> np.ndarray:
    """Same array order and RNG as the repository's Data collection script."""
    if cfg.scenario not in {"full_stock", "uniform"}:
        raise ValueError("simulate_target requires a single scenario")
    rng = np.random.default_rng(cfg.target_seed)
    dt = cfg.years / cfg.horizon
    eps = rng.standard_normal((cfg.target_n, cfg.horizon))
    excess = np.expm1((cfg.drift - 0.5 * cfg.sigma**2 - cfg.risk_free) * dt
                      + cfg.sigma * math.sqrt(dt) * eps)
    low, high = (1., 1.) if cfg.scenario == "full_stock" else (0., 1.)
    fractions = rng.uniform(low, high, size=eps.shape)
    wealth = np.full(cfg.target_n, cfg.s0, dtype=np.float64)
    for t in range(cfg.horizon):
        wealth = math.exp(cfg.risk_free * dt) * wealth * (1 + fractions[:, t] * excess[:, t])
    return wealth


def target_samples(cfg: Config) -> np.ndarray:
    if cfg.target_file:
        values = np.asarray(np.load(cfg.target_file.format(scenario=cfg.scenario),
                                    allow_pickle=False), dtype=np.float64).reshape(-1)
    else:
        values = simulate_target(cfg)
    if len(values) < 2 or not np.isfinite(values).all() or np.any(values <= 0):
        raise ValueError("Target requires at least two finite positive terminal wealth samples")
    return values


def make_grid(cfg: Config):
    grid = np.linspace(-cfg.frequency_cutoff, cfg.frequency_cutoff, cfg.frequencies)
    delta = grid[1] - grid[0]
    weights = np.full_like(grid, delta)
    if cfg.quadrature == "trapezoid":
        weights[[0, -1]] *= 0.5
    return torch.tensor(grid, dtype=torch.float32), torch.tensor(
        weights * np.exp(-cfg.weight_alpha * grid**2), dtype=torch.float32)


def numpy_cf(values, grid, chunk=1024):
    values, grid = np.asarray(values, dtype=np.float64), np.asarray(grid, dtype=np.float64)
    total = np.zeros(len(grid), dtype=np.complex128)
    for start in range(0, len(values), chunk):
        total += np.exp(1j * values[start:start + chunk, None] * grid).sum(axis=0)
    return total / len(values)


def characteristic_function(values, grid):
    return torch.exp(1j * values[:, None] * grid[None, :]).mean(0)


def cf_loss(values, grid, weights, target_cf):
    return (weights * (characteristic_function(values, grid) - target_cf).abs().square()).sum()


def local_generator(policy, seed):
    return torch.Generator(device=next(policy.parameters()).device).manual_seed(seed)


def training_backward(policy, cfg, grid, weights, target_cf, generator):
    """One batch = one update, even when trajectories are processed in chunks.

    For a large batch first estimate its full empirical CF without a graph. Replay
    exactly the same noises and differentiate 2 Re[(phi_hat-target)* d phi_hat].
    The residual is fixed during replay. This is the ordinary same-batch gradient,
    NOT a cross-fit or independent-batch training estimator.
    """
    policy.zero_grad(set_to_none=True)
    if cfg.train_batch <= cfg.train_chunk:
        loss = cf_loss(rollout(policy, cfg.train_batch, cfg, generator), grid, weights, target_cf)
        loss.backward()
        return float(loss.detach())
    before = generator.get_state()
    phi = torch.zeros_like(target_cf)
    with torch.no_grad():
        for start in range(0, cfg.train_batch, cfg.train_chunk):
            n = min(cfg.train_chunk, cfg.train_batch - start)
            phi += (n / cfg.train_batch) * characteristic_function(rollout(policy, n, cfg, generator), grid)
    difference = (phi - target_cf).detach()
    loss = float((weights * difference.abs().square()).sum())
    generator.set_state(before)
    for start in range(0, cfg.train_batch, cfg.train_chunk):
        n = min(cfg.train_chunk, cfg.train_batch - start)
        phi_part = characteristic_function(rollout(policy, n, cfg, generator), grid)
        surrogate = 2 * (n / cfg.train_batch) * (weights * (difference.conj() * phi_part).real).sum()
        surrogate.backward()
    return loss


@torch.no_grad()
def sample_outcomes(policy, n, cfg, seed):
    generator = local_generator(policy, seed)
    chunks = [rollout(policy, min(cfg.eval_chunk, n - start), cfg, generator).cpu().numpy()
              for start in range(0, n, cfg.eval_chunk)]
    result = np.concatenate(chunks)
    if not np.isfinite(result).all() or np.any(result <= 0):
        raise FloatingPointError("Nonfinite or nonpositive simulated wealth")
    return result


def evaluate_losses(policy, cfg, grid, weights, target_cf, n, count, seed):
    u, w, target = (x.detach().cpu().numpy() for x in (grid, weights, target_cf))
    return [float(np.sum(w * np.abs(numpy_cf(sample_outcomes(policy, n, cfg, seed + k), u)
                                                  - target)**2)) for k in range(count)]


def comma_numbers(value):
    values = [float(x.strip()) for x in value.split(",")]
    if not values or not all(math.isfinite(x) for x in values):
        raise ValueError("Expected a comma-separated list of finite numbers")
    return values


def probe_spec(cfg):
    states = comma_numbers(cfg.action_states)
    steps = list(range(cfg.horizon)) if cfg.action_steps == "all" else [
        cfg.horizon - 1 if t.strip() == "last" else int(t) for t in cfg.action_steps.split(",")]
    steps = list(dict.fromkeys(steps))
    if len(set(states)) != len(states) or any(s <= 0 for s in states):
        raise ValueError("Action wealth states must be distinct and positive")
    if not steps or any(t < 0 or t >= cfg.horizon for t in steps):
        raise ValueError("Probe step outside decision times 0,...,horizon-1")
    return {"states": states, "steps": steps,
            "points": [[s, t] for t in steps for s in states]}


@torch.no_grad()
def action_samples(policy, cfg, spec, n, seed, sort=True):
    # CPU-generated, common z across cells/policies; independent of training RNG.
    noise = torch.randn(n, generator=torch.Generator().manual_seed(seed))
    parameter = next(policy.parameters())
    noise = noise.to(device=parameter.device, dtype=parameter.dtype)
    values = []
    for wealth, step in spec["points"]:
        pieces = []
        for start in range(0, n, cfg.eval_chunk):
            z = noise[start:start + cfg.eval_chunk, None]
            s = torch.full_like(z, wealth)
            tau = torch.full_like(z, (cfg.horizon - step) / cfg.horizon)
            pieces.append(policy(s, torch.zeros_like(s), z, tau)[:, 0].cpu().numpy())
        values.append(np.concatenate(pieces))
    values = np.stack(values)
    if not np.isfinite(values).all():
        raise FloatingPointError("Nonfinite action probes")
    return np.sort(values, axis=1) if sort else values


def cpu_state(policy):
    return {k: v.detach().cpu().clone() for k, v in policy.state_dict().items()}


def w1_actions(a, b):
    return np.abs(a.astype(np.float64) - b.astype(np.float64)).mean(axis=1)


class ActionMonitor:
    def __init__(self, policy, cfg, saved=None):
        self.cfg, self.spec = cfg, probe_spec(cfg)
        if saved:
            self.initial = saved["initial"]
            self.previous = saved["previous"]
            self.previous_epoch = saved["previous_epoch"]
            self.bank = deque(saved["bank"], maxlen=cfg.action_lag + 2)
            self.previous_state = saved["previous_state"]
            self.initial_state = saved["initial_state"]
            self.records = saved["records"]
            self.predecessor_state = saved["predecessor_state"]
        else:
            self.initial = action_samples(policy, cfg, self.spec, cfg.action_samples, cfg.action_seed)
            self.previous, self.previous_epoch = self.initial, -1
            self.bank = deque([(-1, self.initial)], maxlen=cfg.action_lag + 2)
            self.initial_state = self.previous_state = cpu_state(policy)
            self.predecessor_state, self.records = self.initial_state, []

    def observe(self, policy, epoch):
        current = action_samples(policy, self.cfg, self.spec, self.cfg.action_samples, self.cfg.action_seed)
        prior_epoch = self.previous_epoch
        lag = next((x for e, x in self.bank if e == epoch - self.cfg.action_lag), None)
        distances = {"previous": w1_actions(current, self.previous),
                     "initial": w1_actions(current, self.initial),
                     "lag": w1_actions(current, lag) if lag is not None else None}
        row = {"epoch": epoch, "previous_epoch": prior_epoch,
               "epoch_gap": epoch - prior_epoch,
               "lag_epoch": epoch - self.cfg.action_lag if lag is not None else None}
        for name, values in distances.items():
            row[name + "_mean"] = float(values.mean()) if values is not None else None
            row[name + "_max"] = float(values.max()) if values is not None else None
            row[name + "_per_cell"] = values.tolist() if values is not None else None
        self.records.append(row)
        self.predecessor_state = self.previous_state
        self.previous_state = cpu_state(policy)
        self.previous, self.previous_epoch = current, epoch
        self.bank.append((epoch, current))
        return row

    def state_dict(self):
        return {k: getattr(self, k) for k in ("initial", "previous", "previous_epoch", "bank",
                "previous_state", "initial_state", "predecessor_state", "records")} | {"bank": list(self.bank)}

    def save(self, output):
        write_json(output / "action_stability_history.json", {"spec": self.spec, "seed": self.cfg.action_seed,
                                                             "records": self.records})
        write_csv(output / "action_stability_history.csv", [
            {k: v for k, v in row.items() if not k.endswith("_per_cell")} for row in self.records])
        cells = []
        for row in self.records:
            for j, (wealth, step) in enumerate(self.spec["points"]):
                cells.append({"epoch": row["epoch"], "wealth": wealth, "step": step,
                              **{k: row[k + "_per_cell"][j] if row[k + "_per_cell"] is not None else None
                                 for k in ("previous", "initial", "lag")}})
        write_csv(output / "action_stability_grid.csv", cells)
        fig, axes = plt.subplots(3, 1, figsize=(8, 9), sharex=True)
        for ax, name in zip(axes, ("initial", "lag", "previous")):
            for stat in ("mean", "max"):
                ax.plot([r["epoch"] for r in self.records],
                        [r[name + "_" + stat] for r in self.records], label=stat)
            ax.set_ylabel(f"Action W1 vs {name}")
            ax.set_yscale("symlog", linthresh=1e-6)
            ax.legend()
        axes[-1].set_xlabel("Epoch (post-update policy)")
        fig.tight_layout()
        save_figure(fig, output / "action_stability_history", self.cfg.figure_dpi)


def write_csv(path, rows):
    if not rows:
        return
    with path.open("w", newline="") as handle:
        writer = csv.DictWriter(handle, fieldnames=list(rows[0]))
        writer.writeheader()
        writer.writerows(rows)


def analytic_moments(cfg, mean_fraction, second_fraction):
    """Exact moments for iid fractions independent of wealth and market noise."""
    dt = cfg.years / cfg.horizon
    q1 = math.exp((cfg.drift - cfg.risk_free) * dt)
    q2 = math.exp(2 * (cfg.drift - cfg.risk_free) * dt + cfg.sigma**2 * dt)
    a = math.exp(cfg.risk_free * dt) * (1 + mean_fraction * (q1 - 1))
    b = math.exp(2 * cfg.risk_free * dt) * (
        1 + 2 * mean_fraction * (q1 - 1) + second_fraction * (q2 - 2 * q1 + 1))
    mean = cfg.s0 * a ** cfg.horizon
    variance = max(0., cfg.s0**2 * b**cfg.horizon - mean**2)
    return {"mean": mean, "std": math.sqrt(variance)}


def distribution_metrics(target, learned):
    # Exact empirical W1, including unequal sample sizes, via integrated CDFs.
    a, b = np.sort(target), np.sort(learned)
    points = np.sort(np.concatenate((a, b)))
    fa = np.searchsorted(a, points, side="right") / len(a)
    fb = np.searchsorted(b, points, side="right") / len(b)
    return {"w1": float(np.sum(np.abs(fa[:-1] - fb[:-1]) * np.diff(points))),
            "ks": float(np.max(np.abs(fa - fb))),
            "target_mean": float(a.mean()), "learned_mean": float(b.mean()),
            "target_std": float(a.std()), "learned_std": float(b.std()),
            "target_quantiles_01_05_50_95_99": np.quantile(a, [.01, .05, .5, .95, .99]).tolist(),
            "learned_quantiles_01_05_50_95_99": np.quantile(b, [.01, .05, .5, .95, .99]).tolist()}


def crossfit_gradient(policy, cfg, grid, weights, target_cf):
    generator = local_generator(policy, cfg.seed + 400000)
    gradients = []
    for _ in range(cfg.audit_replicates):
        with torch.no_grad():
            phi_a = characteristic_function(rollout(policy, cfg.audit_batch, cfg, generator), grid)
        phi_b = characteristic_function(rollout(policy, cfg.audit_batch, cfg, generator), grid)
        surrogate = 2 * (weights * ((phi_a - target_cf).conj() * phi_b).real).sum()
        policy.zero_grad(set_to_none=True)
        surrogate.backward()
        gradients.append(torch.cat([p.grad.flatten().detach() for p in policy.parameters()]))
    policy.zero_grad(set_to_none=True)
    matrix = torch.stack(gradients)
    mean = matrix.mean(0)
    se = (float(((matrix - mean).square().sum(1).sum() / (len(matrix) - 1) / len(matrix)).sqrt())
          if len(matrix) > 1 else None)
    norm = float(mean.norm())
    upper = norm + se / math.sqrt(.05) if se is not None else None
    return {"mean_gradient_norm": norm, "gradient_standard_error_norm": se,
            "plug_in_gradient_norm_screen": upper, "gradient_tolerance": cfg.gradient_tolerance,
            "small_gradient_supported": upper is not None and upper <= cfg.gradient_tolerance,
            "replicates": cfg.audit_replicates, "trajectories_per_half_batch": cfg.audit_batch}, mean


def perturbation_audit(policy, cfg, grid, weights, target_cf, gradient):
    base = parameters_to_vector(policy.parameters()).detach().clone()
    generator = local_generator(policy, cfg.seed + 500000)
    directions = []
    if float(gradient.norm()) > 0:
        directions.append(("measured_gradient", gradient / gradient.norm()))
    for i in range(cfg.perturbation_directions):
        z = torch.randn(base.shape, device=base.device, generator=generator)
        directions.append((f"random_{i}", z / z.norm()))
    seed = cfg.seed + 510000
    baseline = np.array(evaluate_losses(policy, cfg, grid, weights, target_cf,
        cfg.perturbation_batch, cfg.perturbation_replicates, seed))
    results = []
    try:
        for relative_scale in comma_numbers(cfg.perturbation_scales):
            step = relative_scale * max(float(base.norm()), 1.)
            for label, direction in directions:
                for sign in (-1, 1):
                    vector_to_parameters(base + sign * step * direction, policy.parameters())
                    changed = np.array(evaluate_losses(policy, cfg, grid, weights, target_cf,
                        cfg.perturbation_batch, cfg.perturbation_replicates, seed))
                    delta = changed - baseline
                    se = float(delta.std(ddof=1) / math.sqrt(len(delta))) if len(delta) > 1 else None
                    results.append({"relative_scale": relative_scale, "step_norm": step,
                        "direction": label, "sign": sign, "paired_changes": delta.tolist(),
                        "mean_change": float(delta.mean()), "standard_error": se,
                        "detected_descent": se is not None and bool(np.all(delta < 0) and delta.mean() + 4 * se < 0)})
    finally:
        vector_to_parameters(base, policy.parameters())
    return {"results": results, "descent_detected": any(r["detected_descent"] for r in results),
            "note": "Exploratory screen with paired random streams; no formal confidence guarantee."}


def audit_policy(policy, cfg, target, grid, weights, target_cf, output, checkpoint):
    values = evaluate_losses(policy, cfg, grid, weights, target_cf, cfg.test_batch,
                             cfg.test_replicates, cfg.seed + 300000)
    u, w, phi_target = [x.detach().cpu().numpy() for x in (grid, weights, target_cf)]
    crossfit_values = []
    for k in range(cfg.test_replicates):
        a = numpy_cf(sample_outcomes(policy, cfg.test_batch, cfg, cfg.seed + 310000 + 2*k), u)
        b = numpy_cf(sample_outcomes(policy, cfg.test_batch, cfg, cfg.seed + 310001 + 2*k), u)
        crossfit_values.append(float(np.sum(w * ((a - phi_target) * (b - phi_target).conj()).real)))
    grad, mean_grad = crossfit_gradient(policy, cfg, grid, weights, target_cf)
    geometry = perturbation_audit(policy, cfg, grid, weights, target_cf, mean_grad)
    torch.save({"mean_gradient": mean_grad.cpu(), "config": asdict(cfg)}, output / "audit_mean_gradient.pt")
    learned = sample_outcomes(policy, cfg.test_batch, cfg, cfg.seed + 600000)
    np.save(output / "audit_terminal_wealth.npy", learned)
    metrics = distribution_metrics(target, learned)
    # Dense low frequencies expose fits that the coarse historical grid can miss.
    dense_grid = np.linspace(-.5, .5, 1001)
    target_dense, learned_dense = numpy_cf(target, dense_grid), numpy_cf(learned, dense_grid)
    dense_error = np.abs(target_dense - learned_dense)
    np.savez_compressed(output / "audit_dense_cf.npz", frequencies=dense_grid,
                        target_cf=target_dense, learned_cf=learned_dense)
    stability = []
    saved_monitor = checkpoint.get("action_monitor")
    if saved_monitor and cfg.action_samples:
        spec = probe_spec(cfg)
        for label, state in (("initial", saved_monitor["initial_state"]),
                             ("previous_monitored", saved_monitor["predecessor_state"])):
            reference = Policy(cfg).to(next(policy.parameters()).device)
            reference.load_state_dict(state)
            comparisons = []
            for k in range(cfg.test_replicates):
                seed = cfg.action_seed + 10000000 + k
                comparisons.append(w1_actions(
                    action_samples(policy, cfg, spec, cfg.action_samples, seed),
                    action_samples(reference, cfg, spec, cfg.action_samples, seed)))
            distance = np.stack(comparisons)
            stability.append({"reference": label, "mean_w1": float(distance.mean()),
                              "max_cell_mean_w1": float(distance.mean(0).max()),
                              "per_cell_replicates": distance.tolist()})
    verdict = ("Nearby descent detected; a local minimum is not supported." if geometry["descent_detected"]
               else "Small gradient supported; local-minimum candidate only." if grad["small_gradient_supported"]
               else "Stationarity is not established.")
    result = {"checkpoint_epoch": checkpoint["epoch"], "config": asdict(cfg),
              "fresh_test_loss_mean": float(np.mean(values)), "fresh_test_losses": values,
              "fresh_test_loss_sd": float(np.std(values, ddof=1)) if len(values)>1 else None,
              "crossfit_loss_mean": float(np.mean(crossfit_values)),
              "crossfit_loss_standard_error": float(np.std(crossfit_values, ddof=1)/math.sqrt(len(values))) if len(values)>1 else None,
              "crossfit_loss_values": crossfit_values,
              "approximate_matched_sampling_floor": float(np.sum(w * (1 - np.abs(phi_target)**2)) / cfg.test_batch),
              "distribution": metrics, "gradient_audit": grad, "perturbation_audit": geometry,
              "dense_low_frequency_cf_max_error": float(dense_error.max()),
              "dense_low_frequency_cf_mean_square": float(np.mean(dense_error**2)),
              "action_stability_audit": stability, "verdict": verdict,
              "baseline_exact_moments": {"full_stock": analytic_moments(cfg, 1, 1),
                  "uniform_fraction": analytic_moments(cfg, .5, 1/3),
                  "constant_half_fraction": analytic_moments(cfg, .5, .25)},
              "limits": ["Fixed empirical target and finite frequency grid.",
                         "Training uses the usual same-batch squared loss; cross-fitting is for audits.",
                         "Estimated gradient uncertainty and perturbations are numerical screens, not proofs.",
                         "A coarse CF grid can miss distribution differences; inspect dense CF and W1.",
                         "Uniform fractions and constant 0.5 fractions do not have identical terminal laws."]}
    write_json(output / "summary.json", result)
    (output / "report.md").write_text(
        f"# Black--Scholes audit\n\nScenario: {cfg.scenario}; seed: {cfg.seed}; selected epoch: {checkpoint['epoch']}.\n\n"
        f"Fresh CF loss: {result['fresh_test_loss_mean']:.6g}; empirical W1: {metrics['w1']:.6g}; KS: {metrics['ks']:.6g}.\n\n"
        f"Dense low-frequency CF max discrepancy: {dense_error.max():.6g}.\n\n{verdict}\n\n"
        "The cross-fit loss can be negative. Gradient uncertainty is an estimated screen, not a formal confidence interval. "
        "Action stability alone does not establish stationarity or accurate terminal-wealth matching.\n")
    return result


def save_figure(fig, stem, dpi):

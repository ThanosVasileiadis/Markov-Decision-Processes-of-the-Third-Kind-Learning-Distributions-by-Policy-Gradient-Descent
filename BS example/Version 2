def kde_line(ax, values, color):
    values = np.asarray(values, dtype=np.float64)
    if values.min() == values.max():
        return
    bandwidth = 1.06 * values.std() * len(values)**(-.2)
    if bandwidth <= 0:
        return
    x = np.linspace(values.min() - 3*bandwidth, values.max() + 3*bandwidth, 400)
    density = np.zeros_like(x)
    for start in range(0, len(values), 1024):
        z = (x[:, None] - values[None, start:start+1024]) / bandwidth
        density += np.exp(-.5*z*z).sum(1)
    ax.plot(x, density / (len(values)*bandwidth*math.sqrt(2*math.pi)), color=color)


def plot_density_histogram(ax, samples, bins=100, **kwargs):
    """Plot without duplicate float32 bin edges or fabricated sample variance.

    Near-deterministic CUDA policies can produce only one or two distinct float32
    values. Integer-bin histogram construction can then round multiple edges to
    the same number. Promote plotting values to float64 and provide strictly
    increasing explicit edges. Exact point masses are drawn as vertical lines.
    The original samples, policy and training objective are untouched.
    """
    values = np.asarray(samples, dtype=np.float64).reshape(-1)
    if values.size == 0 or not np.isfinite(values).all():
        raise ValueError("Histogram samples must be nonempty and finite")
    if not isinstance(bins, int) or bins < 1:
        raise ValueError("Histogram bins must be a positive integer")
    low, high = float(values.min()), float(values.max())
    if low == high:
        label = kwargs.get("label")
        color = kwargs.get("color", f"C{len(ax.lines) % 10}")
        return ax.axvline(low, color=color,
                          label=f"{label} (point mass)" if label else "Point mass")
    edges = np.unique(np.linspace(low, high, bins + 1, dtype=np.float64))
    return ax.hist(values, bins=edges, density=True, **kwargs)


def plot_histogram(ax, target, learned):
    plot_density_histogram(ax, target, color="blue", alpha=.4, label="Empirical Target")
    plot_density_histogram(ax, learned, color="red", alpha=.4, label=r"Learned $S_N$")
    kde_line(ax, target, "blue")
    kde_line(ax, learned, "red")
    ax.set_xlabel(r"Terminal Wealth $S_N$")
    ax.set_ylabel("Density")
    ax.legend()


def plot_cf(axes, grid, target_cf, learned_cf):
    for ax, component, label in zip(axes, ("real", "imag"), ("Re", "Im")):
        ax.plot(grid, getattr(target_cf, component), "--", label=f"Target {label} φ")
        ax.plot(grid, getattr(learned_cf, component), label=f"Learned {label} φ")
        ax.set_ylabel(f"{label} φ(ω)")
        ax.legend()
        ax.grid(True)
    axes[-1].set_xlabel("ω")



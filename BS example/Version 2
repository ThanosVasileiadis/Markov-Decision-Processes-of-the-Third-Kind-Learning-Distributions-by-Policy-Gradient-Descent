def checkpoint_payload(policy, optimizer, cfg, epoch, generator, target, grid,
                       weights, target_cf, rows, best_loss, best_epoch, monitor):
    return {"schema_version": SCHEMA_VERSION, "state_dict": cpu_state(policy),
            "optimizer_state_dict": copy.deepcopy(optimizer.state_dict()),
            "config": asdict(cfg), "epoch": epoch, "history": copy.deepcopy(rows),
            "best_validation_mean": best_loss, "best_epoch": best_epoch,
            "target_samples": torch.from_numpy(target.copy()),
            "target_cf": target_cf.detach().cpu().clone(),
            "frequencies": grid.detach().cpu().clone(), "weights": weights.detach().cpu().clone(),
            "train_generator_state": generator.get_state().cpu(),
            "torch_rng_state": torch.get_rng_state(),
            "cuda_rng_state_all": torch.cuda.get_rng_state_all() if torch.cuda.is_available() else None,
            "numpy_rng_state": np.random.get_state(), "python_rng_state": random.getstate(),
            "action_monitor": copy.deepcopy(monitor.state_dict()) if monitor else None,
            "source_sha256": sha256(Path(__file__))}


def save_checkpoint(path, payload):
    # Atomic replacement leaves the previous completed checkpoint intact on interruption.
    payload = copy.deepcopy(payload)
    def cpu_tensors(value):
        if torch.is_tensor(value):
            return value.detach().cpu()
        if isinstance(value, dict):
            return {k: cpu_tensors(v) for k, v in value.items()}
        if isinstance(value, list):
            return [cpu_tensors(v) for v in value]
        if isinstance(value, tuple):
            return tuple(cpu_tensors(v) for v in value)
        return value
    temporary = path.with_suffix(".pt.tmp")
    torch.save(cpu_tensors(payload), temporary)
    temporary.replace(path)


def load_policy(path, device="cpu"):
    checkpoint = load_checkpoint(path)
    if checkpoint.get("schema_version") != SCHEMA_VERSION:
        raise ValueError("Unsupported BS checkpoint schema")
    cfg = Config(**checkpoint["config"])
    policy = Policy(cfg).to(device)
    policy.load_state_dict(checkpoint["state_dict"])
    policy.eval()
    return policy, cfg, checkpoint


def runtime_metadata(device, started):
    result = {"elapsed_seconds": time.perf_counter() - started, "python": platform.python_version(),
              "torch": torch.__version__, "numpy": np.__version__, "matplotlib": matplotlib.__version__,
              "device": str(device), "cpu_threads": torch.get_num_threads(),
              "cuda_runtime": torch.version.cuda, "platform": platform.platform(),
              "slurm_job_id": os.environ.get("SLURM_JOB_ID")}
    if device.type == "cuda":
        result.update(gpu=torch.cuda.get_device_name(device),
                      peak_allocated_bytes=torch.cuda.max_memory_allocated(device))
    return result


def train(cfg: Config, resume=None):
    validate(cfg)
    started = time.perf_counter()
    device = configure_runtime(cfg)
    output = Path(cfg.output).expanduser().resolve() / cfg.scenario / f"seed_{cfg.seed}"
    output.mkdir(parents=True, exist_ok=True)
    if (output / "last_policy.pt").exists() and resume is None:
        raise FileExistsError(f"Run exists: {output}. Use --resume-from or a new --output.")
    if resume is not None and resume.get("source_sha256") != sha256(Path(__file__)):
        raise ValueError("Code differs from checkpoint source; use its saved source_snapshot.py to resume exactly")
    if resume is not None and torch.device(resume["config"]["device"]).type != device.type:
        raise ValueError("Exact resume requires the same device type. Portable evaluation works with --audit-checkpoint or --plot-checkpoint.")
    torch.manual_seed(cfg.seed)
    np.random.seed(cfg.seed)
    random.seed(cfg.seed)
    policy = Policy(cfg).to(device)
    optimizer = (torch.optim.Adam if cfg.optimizer == "adam" else torch.optim.SGD)(
        policy.parameters(), lr=cfg.learning_rate)
    generator = local_generator(policy, cfg.seed + 100000)
    target = resume["target_samples"].numpy().copy() if resume else target_samples(cfg)
    if resume:
        grid, weights, target_cf = [resume[k].to(device) for k in ("frequencies", "weights", "target_cf")]
        policy.load_state_dict(resume["state_dict"])
        optimizer.load_state_dict(resume["optimizer_state_dict"])
        generator.set_state(resume["train_generator_state"])
        torch.set_rng_state(resume["torch_rng_state"])
        if device.type == "cuda" and resume.get("cuda_rng_state_all"):
            torch.cuda.set_rng_state_all(resume["cuda_rng_state_all"])
        np.random.set_state(resume["numpy_rng_state"])
        random.setstate(resume["python_rng_state"])
        rows = copy.deepcopy(resume["history"])
        best_loss, best_epoch = resume["best_validation_mean"], resume["best_epoch"]
        start_epoch = resume["epoch"] + 1
        if cfg.epochs <= start_epoch:
            raise ValueError("epochs is the total budget and must exceed the resumed update count")
        if best_epoch == resume["epoch"] and not (output / "best_policy.pt").exists():
            save_checkpoint(output / "best_policy.pt", resume)
        elif not (output / "best_policy.pt").exists():
            raise ValueError("Resuming into a new folder also requires the historical best_policy.pt; use the original --output")
    else:
        grid, weights = make_grid(cfg)
        target_cf = torch.tensor(numpy_cf(target, grid.numpy()), dtype=torch.complex64)
        grid, weights, target_cf = grid.to(device), weights.to(device), target_cf.to(device)
        rows, best_loss, best_epoch, start_epoch = [], math.inf, -1, 0
    monitor = ActionMonitor(policy, cfg, resume.get("action_monitor") if resume else None) if cfg.action_samples else None
    np.save(output / "target_samples.npy", target)
    np.savez_compressed(output / "target_cf.npz", frequencies=grid.cpu().numpy(),
                        weights=weights.cpu().numpy(), target_cf=target_cf.cpu().numpy())
    write_json(output / "config.json", asdict(cfg))
    snapshot = output / "source_snapshot.py"
    if Path(__file__).resolve() != snapshot.resolve():
        shutil.copyfile(__file__, snapshot)
    write_json(output / "provenance.json", {"reference_code": SOURCE_URL,
        "source_sha256": sha256(Path(__file__)), "target_sha256": sha256(output / "target_samples.npy"),
        "target_origin": cfg.target_file or f"generated iid {cfg.scenario} fractions; target seed {cfg.target_seed}",
        "historical_figures_exactly_reconstructed": False,
        "profile": cfg.profile, "resume_from_epoch": resume["epoch"] if resume else None})
    if not resume:
        payload = checkpoint_payload(policy, optimizer, cfg, -1, generator, target, grid,
                                     weights, target_cf, rows, best_loss, best_epoch, monitor)
        save_checkpoint(output / "initial_policy.pt", payload)
    log_path = output / "history.csv"
    # Reconstruct from checkpoint so a partially written CSV is never trusted on resume.
    write_csv(log_path, rows)
    for epoch in range(start_epoch, cfg.epochs):
        rate = (cfg.learning_rate / (1 + epoch / cfg.decay_timescale)**cfg.decay_exponent
                if cfg.optimizer == "sgd" else cfg.learning_rate)
        optimizer.param_groups[0]["lr"] = rate
        policy.train()
        loss = training_backward(policy, cfg, grid, weights, target_cf, generator)
        norm = math.sqrt(sum(float(p.grad.detach().square().sum()) for p in policy.parameters()))
        if not math.isfinite(loss) or not math.isfinite(norm):
            raise FloatingPointError(f"Nonfinite training loss/gradient at epoch {epoch}")
        optimizer.step()
        policy.eval()
        stop = cfg.early_stop > 0 and loss < cfg.early_stop
        evaluation_epoch = epoch % cfg.eval_every == 0 or epoch == cfg.epochs-1 or stop
        action_record = (monitor.observe(policy, epoch) if monitor and
                         (epoch % cfg.action_every == 0 or evaluation_epoch) else None)
        vals = (evaluate_losses(policy, cfg, grid, weights, target_cf, cfg.validation_batch,
                cfg.validation_replicates, cfg.seed + 200000 + epoch*100) if evaluation_epoch else [])
        mean = float(np.mean(vals)) if vals else None
        row = {"epoch": epoch, "train_loss": loss, "gradient_norm": norm, "learning_rate": rate,
               "validation_mean": mean,
               "validation_sd": float(np.std(vals, ddof=1)) if len(vals)>1 else 0. if vals else None,
               "action_w1_previous_mean": action_record["previous_mean"] if action_record else None,
               "action_w1_previous_max": action_record["previous_max"] if action_record else None,
               "action_w1_initial_mean": action_record["initial_mean"] if action_record else None,
               "action_w1_lag_mean": action_record["lag_mean"] if action_record else None}
        rows.append(row)
        with log_path.open("a", newline="") as handle:
            writer = csv.DictWriter(handle, fieldnames=list(row))
            if handle.tell() == 0:
                writer.writeheader()
            writer.writerow(row)
            handle.flush()
        improved = mean is not None and mean < best_loss
        if improved:
            best_loss, best_epoch = mean, epoch
        if improved or (epoch+1) % cfg.checkpoint_every == 0 or epoch == cfg.epochs-1 or stop:
            payload = checkpoint_payload(policy, optimizer, cfg, epoch, generator, target, grid,
                                         weights, target_cf, rows, best_loss, best_epoch, monitor)
            save_checkpoint(output / "last_policy.pt", payload)
            if improved:
                save_checkpoint(output / "best_policy.pt", payload)
            if (epoch+1) % cfg.checkpoint_every == 0 or epoch == cfg.epochs-1 or stop:
                folder = output / "checkpoints"
                folder.mkdir(exist_ok=True)
                save_checkpoint(folder / f"epoch_{epoch:06d}.pt", payload)
        if evaluation_epoch:
            print(f"{cfg.scenario} seed={cfg.seed} epoch={epoch} train={loss:.6g} "
                  f"validation={mean:.6g} gradient={norm:.4g}", flush=True)
        if stop:
            break
    if monitor:
        monitor.save(output)
    plot_history(rows, output, cfg.figure_dpi)
    selected = load_checkpoint(output / f"{cfg.figure_policy}_policy.pt")
    policy.load_state_dict(selected["state_dict"])
    make_figures(policy, cfg, target, grid, target_cf, output, selected["epoch"],
                 output / f"{cfg.figure_policy}_policy.pt")
    result = (audit_policy(policy, cfg, target, grid, weights, target_cf, output, selected)
              if cfg.audit else {"audit_performed": False, "checkpoint_epoch": selected["epoch"]})
    write_json(output / "run_summary.json", {"best_epoch": best_epoch, "best_validation_mean": best_loss,
               "last_epoch": rows[-1]["epoch"], "figure_policy": cfg.figure_policy,
               "figure_epoch": selected["epoch"], "stopped_on_training_threshold": stop,
               "audit_performed": cfg.audit})
    if device.type == "cuda":
        torch.cuda.synchronize(device)
    write_json(output / "runtime.json", runtime_metadata(device, started))
    print(f"Saved run: {output}", flush=True)
    return result


def inspect_checkpoint(path, cfg, output, figures_only=False):
    validate(cfg)
    output = Path(output).expanduser().resolve()
    if (output / "last_policy.pt").exists():
        raise ValueError("Choose a separate output directory for an audit")
    output.mkdir(parents=True, exist_ok=True)
    device = configure_runtime(cfg)
    policy, _, checkpoint = load_policy(path, device)
    target = checkpoint["target_samples"].numpy()
    grid, weights, target_cf = [checkpoint[k].to(device) for k in ("frequencies", "weights", "target_cf")]
    make_figures(policy, cfg, target, grid, target_cf, output, checkpoint["epoch"], path)
    if not figures_only:
        return audit_policy(policy, cfg, target, grid, weights, target_cf, output, checkpoint)


def parse_request(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    for name, field in Config.__dataclass_fields__.items():
        default = field.default
        if isinstance(default, bool):
            parser.add_argument("--" + name.replace("_", "-"), action=argparse.BooleanOptionalAction, default=None)
        else:
            parser.add_argument("--" + name.replace("_", "-"), type=type(default), default=None)
    parser.add_argument("--resume-from")
    parser.add_argument("--audit-checkpoint")
    parser.add_argument("--plot-checkpoint")
    parser.add_argument("--replot-data", help="Regenerate figures directly from figure_data.npz")
    args = vars(parser.parse_args(argv))
    modes = {k: args.pop(k) for k in ("resume_from", "audit_checkpoint", "plot_checkpoint", "replot_data")}
    if sum(bool(v) for v in modes.values()) > 1:
        parser.error("Choose at most one resume/audit/plot/replot mode")
    explicit = {k: v for k, v in args.items() if v is not None}
    path = modes["resume_from"] or modes["audit_checkpoint"] or modes["plot_checkpoint"]
    if path:
        cfg = Config(**load_checkpoint(path)["config"])
        mutable = {"output", "device", "cpu_threads", "epochs", "figure_samples", "figure_cf_samples",
                   "figure_action_samples", "figure_dpi", "audit_batch", "audit_replicates", "test_batch",
                   "test_replicates", "gradient_tolerance", "perturbation_scales", "perturbation_directions",
                   "perturbation_batch", "perturbation_replicates", "audit"}
        for name, value in explicit.items():
            if name not in mutable and value != getattr(cfg, name):
                parser.error(f"Changing {name} changes the experiment; start a new run")
            setattr(cfg, name, value)
    else:
        cfg = profile_config(explicit.get("profile", "prototype"))
        for name, value in explicit.items():
            setattr(cfg, name, value)
    if (modes["audit_checkpoint"] or modes["plot_checkpoint"] or modes["replot_data"]) and "output" not in explicit:
        parser.error("Specify --output for audit/plot/replot to preserve the training results")
    return cfg, modes


def main(argv=None):
    cfg, modes = parse_request(argv)
    if modes["replot_data"]:
        render_figure_data(modes["replot_data"], Path(cfg.output), cfg.figure_dpi)
    elif modes["audit_checkpoint"] or modes["plot_checkpoint"]:
        inspect_checkpoint(modes["audit_checkpoint"] or modes["plot_checkpoint"], cfg,
                           cfg.output, figures_only=bool(modes["plot_checkpoint"]))
    elif modes["resume_from"]:
        train(cfg, resume=load_checkpoint(modes["resume_from"]))
    else:
        # Validate before expanding 'both', including its external-target guard.
        validate(cfg)
        scenarios = ("full_stock", "uniform") if cfg.scenario == "both" else (cfg.scenario,)
        seeds = [int(s.strip()) for s in cfg.seeds.split(",")]
        if not seeds or len(set(seeds)) != len(seeds) or any(seed < 0 for seed in seeds):
            raise ValueError("seeds must be distinct nonnegative integers")
        if cfg.seed != 2026 and cfg.seeds == "2026":
            seeds = [cfg.seed]
        for scenario in scenarios:
            for seed in seeds:
                train(replace(cfg, scenario=scenario, seed=seed))


if __name__ == "__main__":
    main()

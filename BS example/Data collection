import numpy as np
import matplotlib.pyplot as plt
from scipy import stats

def simulate_terminal_wealth_uniform(
    paths=20000,
    N=20,
    T=1.0,
    s0=100.0,
    r=0.02,
    mu=0.06,
    sigma=0.20,
    a_low= 1.0,
    a_high= 1.0,
    seed=42,
):
    rng = np.random.default_rng(seed)
    dt = T / N

    # Riskfree growth per step
    growth = np.exp(r * dt)

    # Brownian increments
    eps = rng.standard_normal((paths, N))

    # Excess stock return over the bond
    drift_adj = (mu - 0.5 * sigma**2 - r) * dt
    diff_term = sigma * np.sqrt(dt)
    Y = np.exp(drift_adj + diff_term * eps) - 1.0

    # Uniform controls π_n ∈ [a_low, a_high]
    actions = rng.uniform(a_low, a_high, size=(paths, N))

    # Wealth process
    W = np.full(paths, s0, dtype=float)
    for n in range(N):
        W = growth * (W * (1.0 + actions[:, n] * Y[:, n]))

    return W

# --------------------------
# Parameters
# --------------------------
paths = 20000
N = 20
T = 1.0
s0 = 100.0
r = 0.02
mu = 0.06
sigma = 0.40
a_low = 1.0
a_high = 1.0


# simulate
sN = simulate_terminal_wealth_uniform(
    paths, N, T, s0, r, mu, sigma, a_low, a_high
)


mean_est = np.mean(sN)
std_est  = np.std(sN, ddof=1)


print(f"Estimated mean(S_N): {mean_est:.4f}")
print(f"Estimated std(S_N):  {std_est:.4f}")


# --- normality tests ---
shapiro_stat, shapiro_p = stats.shapiro(sN[:5000])
jb_stat, jb_p = stats.jarque_bera(sN)

print("\nNormality tests for log S_N:")
print(f"  Shapiro–Wilk W = {shapiro_stat:.4f},  p-value = {shapiro_p:.4e}")
print(f"  Jarque–Bera  JB = {jb_stat:.4f},       p-value = {jb_p:.4e}")

if shapiro_p < 0.05 or jb_p < 0.05:
    print("→ Reject normality (S_N not Gaussian).")
else:
    print("→ Fail to reject normality:  S_N is Gaussian -> S_N is lognormal.")


# --- visualization: S_N (should be lognormal) ---
plt.figure(figsize=(8,5))
count, bins, _ = plt.hist(sN, bins=100, density=True, alpha=0.6)
x = np.linspace(np.min(sN), np.max(sN), 500)

plt.xlabel(r"$S_N$")
plt.ylabel("Density")
plt.title("Terminal wealth distribution (should be lognormal)")

plt.tight_layout()
plt.savefig("my_figure.png", dpi=300, bbox_inches="tight")
plt.show()


def save_simulated_terminal_wealth(sN, filename="simulated_terminal_wealth.npy"):
    """
    Saves terminal wealth samples to an .npy file.

    Parameters
    ----------
    sN : np.ndarray
        Terminal wealth samples.
    filename : str
        Output .npy file name (default: 'simulated_terminal_wealth.npy').
    """
    np.save(filename, sN)
    print(f"✔ Saved {len(sN)} samples to '{filename}'")


save_simulated_terminal_wealth(sN)
